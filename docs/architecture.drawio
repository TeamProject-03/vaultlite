  <diagram id="keys" name="Key hierarchy">
    <mxGraphModel dx="704" dy="386" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ktitle" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontSize=18;" value="&lt;b&gt;VaultLite key hierarchy&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="mk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Master key&lt;/b&gt; (256-bit, random)&lt;br&gt;never stored anywhere" vertex="1">
          <mxGeometry height="60" width="260" x="400" y="50" as="geometry" />
        </mxCell>
        <mxCell id="split" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Shamir split, 3 of 5&lt;/b&gt;&lt;br&gt;prime field 2^521 - 1" vertex="1">
          <mxGeometry height="60" width="240" x="60" y="160" as="geometry" />
        </mxCell>
        <mxCell id="shares" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;5 shares&lt;/b&gt;, one per custodian&lt;br&gt;any 3 rebuild the master key&lt;br&gt;(Lagrange interpolation at x = 0)&lt;br&gt;2 shares reveal nothing" vertex="1">
          <mxGeometry height="80" width="240" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="hkdf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;HKDF-SHA256&lt;/b&gt;&lt;br&gt;one subkey per purpose" vertex="1">
          <mxGeometry height="60" width="240" x="560" y="160" as="geometry" />
        </mxCell>
        <mxCell id="krk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Keyring key&lt;/b&gt;&lt;br&gt;info: vaultlite/v1/keyring" vertex="1">
          <mxGeometry height="60" width="230" x="430" y="260" as="geometry" />
        </mxCell>
        <mxCell id="ckk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Check key&lt;/b&gt;&lt;br&gt;info: vaultlite/v1/key-check" vertex="1">
          <mxGeometry height="60" width="210" x="700" y="260" as="geometry" />
        </mxCell>
        <mxCell id="krb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Keyring blob&lt;/b&gt; (stored in DB)&lt;br&gt;the KEK, encrypted with AES-256-GCM" vertex="1">
          <mxGeometry height="60" width="230" x="430" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ckb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Key-check blob&lt;/b&gt; (stored in DB)&lt;br&gt;a known constant, AES-256-GCM&lt;br&gt;detects wrong shares at unseal" vertex="1">
          <mxGeometry height="70" width="210" x="700" y="370" as="geometry" />
        </mxCell>
        <mxCell id="kek" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;KEK&lt;/b&gt; (256-bit vault key)&lt;br&gt;in server RAM only while unsealed" vertex="1">
          <mxGeometry height="60" width="260" x="400" y="490" as="geometry" />
        </mxCell>
        <mxCell id="dek" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;DEK&lt;/b&gt; (256-bit data key)&lt;br&gt;fresh for every secret version" vertex="1">
          <mxGeometry height="60" width="260" x="120" y="610" as="geometry" />
        </mxCell>
        <mxCell id="val" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Secret value&lt;/b&gt;&lt;br&gt;AES-256-GCM with the DEK, fresh 96-bit nonce&lt;br&gt;AAD = path + version" vertex="1">
          <mxGeometry height="70" width="260" x="120" y="710" as="geometry" />
        </mxCell>
        <mxCell id="blob" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Secret blob&lt;/b&gt; (stored in DB)&lt;br&gt;format | wrap nonce | wrapped DEK |&lt;br&gt;nonce | ciphertext + tag" vertex="1">
          <mxGeometry height="70" width="260" x="120" y="820" as="geometry" />
        </mxCell>
        <mxCell id="sk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Ed25519 signing key&lt;/b&gt;&lt;br&gt;private key wrapped by the KEK (in DB)&lt;br&gt;public key stored in clear" vertex="1">
          <mxGeometry height="70" width="260" x="680" y="610" as="geometry" />
        </mxCell>
        <mxCell id="aud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Audit entries&lt;/b&gt;&lt;br&gt;link = SHA-256(previous link + entry)&lt;br&gt;signature = Ed25519(link)" vertex="1">
          <mxGeometry height="70" width="260" x="680" y="720" as="geometry" />
        </mxCell>
        <mxCell id="rotnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" value="&lt;div&gt;&lt;b&gt;Rotation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Master key: &lt;/b&gt;new master key and new shares; same KEK is re-encrypted; no change to secrets; old shares are no longer valid.&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;KEK: &lt;/b&gt;new KEK; all DEK and signing key is re-wrapped; no secret values are re-encrypted.&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="240" x="960" y="50" as="geometry" />
        </mxCell>
        <mxCell id="k1" edge="1" parent="1" source="mk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="split" value="split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k2" edge="1" parent="1" source="split" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="shares" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k3" edge="1" parent="1" source="mk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="hkdf" value="derive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k4" edge="1" parent="1" source="hkdf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="krk" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k5" edge="1" parent="1" source="hkdf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="ckk" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k6" edge="1" parent="1" source="krk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="krb" value="encrypts KEK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k7" edge="1" parent="1" source="ckk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="ckb" value="encrypts constant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8" edge="1" parent="1" source="krb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="kek" value="unseal: decrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k9" edge="1" parent="1" source="kek" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="dek" value="wraps (AES-256-GCM,&lt;br&gt;AAD = path + version)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k10" edge="1" parent="1" source="dek" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="val" value="encrypts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k11" edge="1" parent="1" source="val" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" target="blob" value="">
